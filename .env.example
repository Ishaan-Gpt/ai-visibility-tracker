# --- Firebase client config (Project settings > General > Your apps > Web app) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin SDK (Project settings > Service accounts > Generate new private key) ---
# Paste the full JSON on one line (escape newlines in the private_key as \n, which is how
# Firebase exports it already if you stringify the downloaded JSON file).
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Gemini API key (https://aistudio.google.com/apikey) ---
# Requires a billing account linked to the underlying Google Cloud project — Google's
# Google Search grounding tool (what lets this app see real, current web results) is
# gated behind billing even though actual usage cost is typically $0-negligible at
# low volume. As of 2026 there is no free/no-card alternative for open-web search
# (Google Custom Search and Brave Search both closed their no-card free tiers).
GEMINI_API_KEY=

# --- Shared secret the cron route requires in an Authorization: Bearer <secret> header ---
# Generate any long random string. Vercel Cron is configured to send this automatically
# once set as a Vercel project env var; for local testing pass it manually.
CRON_SECRET=

# --- Optional: keyword volume / difficulty / CPC (https://app.dataforseo.com). Without these, Keyword Research
# shows real autocomplete ideas but no volume numbers (they are never estimated). ---
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# --- Optional: Razorpay subscriptions for the Pro plan. Create a Plan in the Razorpay dashboard, then add a
# webhook to https://<your-domain>/api/billing/webhook with events subscription.activated, .charged, .cancelled,
# .halted, .completed, .expired, .paused and put its secret below. ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID=
RAZORPAY_WEBHOOK_SECRET=

# --- Optional but recommended: Core Web Vitals in Page Audit (Google PageSpeed Insights API).
# Keyless requests share a global quota that is usually exhausted. Create a free key (25,000 requests/day):
# Google Cloud console > APIs & Services > enable "PageSpeed Insights API" > Credentials > Create API key.
PAGESPEED_API_KEY=

# --- Optional: salt for hashing visitor IPs in daily quotas and signing short-lived tokens (falls back to CRON_SECRET).
QUOTA_SALT=

# --- DataForSEO spend guard (applies to keyword research volumes, rank tracking and domain keywords) ---
# Estimated spend cap per UTC day across all users, in USD. Paid calls pause for the rest of the day when reached.
DATAFORSEO_DAILY_BUDGET_USD=0.50
# Last-resort floor: pause paid calls when the DataForSEO balance falls below this (checked at most hourly).
DATAFORSEO_MIN_BALANCE_USD=0.20
# Set to "off" to skip the hourly balance check.
DATAFORSEO_BALANCE_CHECK=

# --- Rank Tracker (optional) ---
# Stop each SERP check once: "own" (your domain is found, cheapest; competitors below you show as ">N"),
# "all" (your domain and every competitor are found) or "off" (always read the full top 100).
RANK_TRACKER_STOP_ON=own
# Faster result collection: DataForSEO pings this base URL when a task is ready (HMAC-signed).
RANK_TRACKER_PINGBACK_BASE_URL=
RANK_TRACKER_PINGBACK_SECRET=
# Email alerts for ranking drops via Resend (https://resend.com). Alerts stay in-app when unset.
RESEND_API_KEY=
ALERT_FROM_EMAIL=
