rules_version = '2';

// All reads/writes in this app go through Next.js server code (Route Handlers /
// Server Actions) using the Firebase Admin SDK, which bypasses these rules entirely.
// The client SDK is only ever used for Firebase Auth, never for direct Firestore
// access. These rules are therefore a defense-in-depth backstop: deny everything,
// so that if a future change ever adds direct client reads/writes by mistake, it
// fails closed instead of silently exposing other users' brands/prompts/runs.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
